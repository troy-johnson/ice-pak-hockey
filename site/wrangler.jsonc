{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "ice-pak-site",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ice-pak",
			"migrations_dir": "migrations"
		}
	],
	// Cloudflare Access values for the manager pages. With empty values, the deployed site refuses each manager request.
	"vars": {
		"TEAM_DOMAIN": "",
		"POLICY_AUD": ""
	}
}