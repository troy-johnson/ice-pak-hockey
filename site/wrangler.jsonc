{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "ice-pak-site",
	// The Astro pages and the Cron Trigger of the Calendar Feed.
	"main": "./src/worker.ts",
	// Each hour at 17 past: read the Calendar Feed (BenchApp). The feed address is the Worker secret CALENDAR_FEED_URL.
	"triggers": {
		"crons": ["17 * * * *"]
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Workers Cache keeps each public page until a Manager save or a Game time. A deploy starts a new, empty cache.
	"cache": {
		"enabled": true
	},
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "icepakhockey.com", "custom_domain": true },
		{ "pattern": "www.icepakhockey.com", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ice-pak",
			"database_id": "a8867fd3-3a00-4ab6-9d00-8b9ad60af35f",
			"migrations_dir": "migrations"
		}
	],
	// Cloudflare Access values for the manager pages: the team domain, and the audience tag of the
	// "Ice Pak Managers" application. With empty values, the deployed site refuses each manager request.
	"vars": {
		"TEAM_DOMAIN": "https://troyjohnson.cloudflareaccess.com",
		"POLICY_AUD": "76623feb14354982c061ce39cda64d9144028bd53086a30487ac1a874287e851"
	}
}