---
import Base from "../layouts/Base.astro";
import PlayerCell from "../components/site/PlayerCell.astro";
import { leagueLabel, seasonLabel, utahTime } from "../lib/game-format";
import { gamesOf, leagueSeasons, playersById, statData } from "../lib/site-data";
import {
  byStat,
  formatPointsPerGame,
  formatRecord,
  formatSavePercentage,
  goalieLines,
  leaders,
  only,
  played,
  skaterLines,
  teamRecord,
  type StatKey,
} from "../lib/stats";

export const prerender = false;

const params = Astro.url.searchParams;
const now = utahTime(new Date());
const games = await gamesOf(Astro.locals);
const [data, players, allSeasons] = await Promise.all([statData(games), playersById(), leagueSeasons()]);
const past = played(data, now);

const playedSeasons = allSeasons.filter((season) => past.games.some((game) => game.leagueSeasonId === season.id));

// The view: all time, or one League Season.
const view = params.has("ls") ? "ls" : "all";
const ls = playedSeasons.find((season) => season.id === Number(params.get("ls"))) ?? playedSeasons[0];
const scoped = view === "ls" ? only(past, (game) => game.leagueSeasonId === ls?.id) : past;

const record = teamRecord(scoped.games);
const diff = record.goalsFor - record.goalsAgainst;
const lines = skaterLines(scoped);
const goalies = goalieLines(scoped).sort((a, b) => b.gamesPlayed - a.gamesPlayed || (b.savePercentage ?? 0) - (a.savePercentage ?? 0));
const shotGames = scoped.games.filter((game) => game.opponentShots != null && game.icePakScore !== null).length;

const SORTS: { key: StatKey; label: string; wide?: boolean }[] = [
  { key: "gamesPlayed", label: "GP" },
  { key: "goals", label: "G" },
  { key: "assists", label: "A" },
  { key: "points", label: "P" },
  { key: "penaltyMinutes", label: "PIM", wide: true },
  { key: "pointsPerGame", label: "P/GP", wide: true },
];
const sort = SORTS.find((each) => each.key === params.get("sort"))?.key ?? "points";
const rows = [...lines].sort(byStat(sort));
const LEADERS: { key: StatKey; label: string }[] = [
  { key: "gamesPlayed", label: "Games played" },
  { key: "goals", label: "Goals" },
  { key: "assists", label: "Assists" },
  { key: "points", label: "Points" },
  { key: "penaltyMinutes", label: "Penalty minutes" },
];
// The League list and the Season list. The League order is the order of the newest League Season.
const leagueNames = [...new Set(playedSeasons.map((season) => season.league))];
const numberOf = (playerId: number) => players.get(playerId)?.number ?? null;
const badge = (playerId: number) => {
  const player = players.get(playerId);
  if (!player) return "?";
  return player.number !== null ? String(player.number) : `${player.firstName[0] ?? ""}${player.lastName[0] ?? ""}`;
};
const POSITION_LETTERS = { forward: "F", defense: "D", goalie: "G" };
const name = (playerId: number) => {
  const player = players.get(playerId);
  return player ? `${player.firstName} ${player.lastName}` : "Unknown player";
};
const viewQuery = view === "ls" ? `ls=${ls?.id}` : "";
const sortHref = (key: StatKey) => `/stats?${[viewQuery, key === "points" ? "" : `sort=${key}`].filter(Boolean).join("&")}`;
const years = [past.games[0]?.startsAt.slice(0, 4), past.games.at(-1)?.startsAt.slice(0, 4)];
---

<Base title="Stats · Ice Pak Hockey" current="stats">
  <div slot="band" class="band">
    <div class="wrap">
      <h1>Stats</h1>
      <div class="controls">
        <form class="seg" role="group" aria-label="Stats view" method="get" data-stats-pick>
          <a href="/stats" aria-current={view === "all" ? "page" : undefined}>All time</a>
          <select aria-label="League" data-league class:list={{ on: view === "ls" }}>
            <option value="">League</option>
            {
              leagueNames.map((league) => (
                <option value={league} selected={view === "ls" && ls?.league === league}>
                  {leagueLabel(league)}
                </option>
              ))
            }
          </select>
          <select name="ls" aria-label="Season" data-season class:list={{ on: view === "ls" }}>
            <option value="">Season</option>
            {
              playedSeasons.map((season) => (
                <option
                  value={season.id}
                  data-lg={season.league}
                  selected={view === "ls" && season.id === ls?.id}
                  hidden={view === "ls" && season.league !== ls?.league}
                >
                  {seasonLabel(season.name)}
                </option>
              ))
            }
          </select>
          <noscript><button>Show</button></noscript>
        </form>
      </div>
    </div>
  </div>

  <div class="stack">
    <div class="card strip team" style="--n:5">
      {
        view === "ls" && ls ? (
          <span class="title lsname">
            <span>
              <span class="label">League</span>
              {leagueLabel(ls.league)}
            </span>
            <span>
              <span class="label">Season</span>
              {seasonLabel(ls.name)}
            </span>
          </span>
        ) : (
          <span class="title">All time</span>
        )
      }
      <div class="key"><span class="label">Record</span><b>{formatRecord(record)}</b></div>
      <div><span class="label">GP</span><b>{record.gamesPlayed}</b></div>
      <div><span class="label">GF</span><b>{record.goalsFor}</b></div>
      <div><span class="label">GA</span><b>{record.goalsAgainst}</b></div>
      <div><span class="label">Diff</span><b>{diff > 0 ? `+${diff}` : diff}</b></div>
    </div>

    {
      lines.length > 0 && (
        <section>
          <div class="sec-head">
            <h2>Leaders</h2>
          </div>
          <div class="leaders">
            {LEADERS.map(({ key, label }) => {
              const [top, ...rest] = leaders(lines, key);
              return (
                <div class="leader card">
                  <span class="label">{label}</span>
                  <div class="top">
                    <span class="av" aria-hidden="true">{badge(top.playerId)}</span>
                    <a href={`/players/${top.playerId}`}>{name(top.playerId)}</a>
                    <b>{top[key]}</b>
                  </div>
                  <ul>
                    {rest.map((line) => (
                      <li>
                        <span>
                          <span class="lno">{numberOf(line.playerId) ?? "–"}</span>
                          <a href={`/players/${line.playerId}`}>{name(line.playerId)}</a>
                        </span>
                        <span>{line[key]}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              );
            })}
          </div>
        </section>
      )
    }

    <section>
      <div class="sec-head">
        <h2>Skaters</h2>
        {
          view === "all" && (
            <span class="muted">
              {years[0]} to {years[1]}
            </span>
          )
        }
      </div>
      {
        rows.length === 0 ? (
          <p class="muted">No Player has a Game or a goal in this view yet.</p>
        ) : (
          <div class="card table-wrap">
            <table>
              <thead>
                <tr>
                  <th class="n">#</th>
                  <th>Player</th>
                  {SORTS.map((each) => (
                    <th class:list={["n", { "wide-only": each.wide, sorted: each.key === sort }]} aria-sort={each.key === sort ? "descending" : undefined}>
                      <a href={sortHref(each.key)}>{each.label}</a>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {rows.map((line) => {
                  const player = players.get(line.playerId);
                  const cell = (key: StatKey, value: string | number) => (
                    <td class:list={["n", { "wide-only": SORTS.find((each) => each.key === key)?.wide, sorted: key === sort }]}>{value}</td>
                  );
                  return (
                    <tr>
                      <td class="n num">{player?.number ?? "–"}</td>
                      <td class="name">
                        <PlayerCell player={player} />
                        {player?.position && <span class="pos">{POSITION_LETTERS[player.position]}</span>}
                      </td>
                      {cell("gamesPlayed", line.gamesPlayed)}
                      {cell("goals", line.goals)}
                      {cell("assists", line.assists)}
                      {cell("points", line.points)}
                      {cell("penaltyMinutes", line.penaltyMinutes)}
                      {cell("pointsPerGame", formatPointsPerGame(line.pointsPerGame))}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )
      }
    </section>

    {
      goalies.length > 0 && (
        <section>
          <div class="sec-head">
            <h2>Goalies</h2>
            <span class="muted">{shotGames === 1 ? "1 Game" : `${shotGames} Games`} with shots on the Scoresheet</span>
          </div>
          <div class="card table-wrap">
            <table>
              <thead>
                <tr>
                  <th class="n">#</th>
                  <th>Goalie</th>
                  <th class="n sorted">GP</th>
                  <th class="n wide-only">W-L-T</th>
                  <th class="n">GA</th>
                  <th class="n wide-only">GAA</th>
                  <th class="n wide-only">SA</th>
                  <th class="n">SV</th>
                  <th class="n">SV%</th>
                  <th class="n wide-only">SO</th>
                </tr>
              </thead>
              <tbody>
                {goalies.map((line) => (
                  <tr>
                    <td class="n num">{numberOf(line.playerId) ?? "–"}</td>
                    <td class="name">
                      <PlayerCell player={players.get(line.playerId)} />
                    </td>
                    <td class="n sorted">{line.gamesPlayed}</td>
                    <td class="n wide-only">
                      {line.wins}-{line.losses}-{line.ties}
                    </td>
                    <td class="n">{line.goalsAgainst}</td>
                    <td class="n wide-only">{line.goalsAgainstAverage.toFixed(2)}</td>
                    <td class="n wide-only">{line.gamesWithShots ? line.shotsAgainst : "–"}</td>
                    <td class="n">{line.gamesWithShots ? line.saves : "–"}</td>
                    <td class="n">{formatSavePercentage(line.savePercentage)}</td>
                    <td class="n wide-only">{line.shutouts}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="muted">
            A Game in goal is a Game where BenchApp lists the Player as the goalie. GA and GAA count the Games with a
            final score. SA, SV, and SV% count only the Games with shots on the Scoresheet. A Game with two goalies counts
            in GP and the record only.
          </p>
        </section>
      )
    }
  </div>
</Base>
