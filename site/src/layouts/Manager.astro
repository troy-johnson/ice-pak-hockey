---
import "../styles/manager.css";
import Base from "./Base.astro";

interface Props {
  title: string;
  /** A short line above the title, such as "Roster Builder · MIC". */
  label?: string;
}

const { title, label = "Managers" } = Astro.props;
const current = Astro.url.pathname.startsWith("/manager/seasons") ? "seasons" : "players";
---

<Base title={`${title} · Ice Pak`} noindex manager current={current}>
  <div slot="band" class="band">
    <div class="wrap">
      <span class="label">{label}</span>
      <h1>{title}</h1>
    </div>
  </div>
  <div class="manager">
    <slot />
  </div>
</Base>
