---
import "../styles/manager.css";
import Base from "./Base.astro";

interface Props {
  title: string;
  /** A short line above the title, such as "Roster Builder · MIC". */
  label?: string;
}

const { title, label = "Managers" } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: "/manager/players", label: "Player Bank" },
  { href: "/manager/seasons", label: "League Seasons" },
];
---

<Base title={`${title} · Ice Pak`} noindex>
  <nav slot="nav" aria-label="Manager">
    {
      links.map((link) => (
        <a href={link.href} aria-current={path.startsWith(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <div slot="band" class="band">
    <div class="wrap">
      <span class="label">{label}</span>
      <h1>{title}</h1>
    </div>
  </div>
  <div class="manager">
    <slot />
  </div>
</Base>
