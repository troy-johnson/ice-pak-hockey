---
import Base from "./Base.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: "/manager/players", label: "Player Bank" },
  { href: "/manager/seasons", label: "League Seasons" },
];
---

<Base title={`${title} · Ice Pak`} noindex>
  <nav slot="nav" aria-label="Manager">
    {
      links.map((link) => (
        <a href={link.href} aria-current={path.startsWith(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <slot />
</Base>
