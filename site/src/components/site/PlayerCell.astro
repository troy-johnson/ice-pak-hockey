---
import type { PublicPlayer } from "../../lib/site-data";

interface Props {
  player: PublicPlayer | undefined;
}

const { player } = Astro.props;
const name = player ? `${player.firstName} ${player.lastName}` : "Unknown player";
---

<span class="who">
  {player ? <a href={`/players/${player.id}`}>{name}</a> : <span>{name}</span>}
</span>
