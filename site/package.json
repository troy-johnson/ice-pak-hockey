{
  "name": "ice-pak-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply ice-pak --local",
    "migrate:remote": "wrangler d1 migrations apply ice-pak --remote",
    "deploy": "pnpm run build && wrangler deploy",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "astro": "^7.4.12",
    "jose": "^6.2.17",
    "wrangler": "^4.162.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}